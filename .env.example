# DB sumber data sensor (t_loggers)
SENSOR_DB_HOST=127.0.0.1
SENSOR_DB_PORT=3307
SENSOR_DB_NAME=aqms_db
SENSOR_DB_USER=root
SENSOR_DB_PASSWORD=

# DB hasil prediksi & metadata model (predictions, model_metadata)
# Sama dengan DB_AQMS_* di bc-enviro-web
RESULT_DB_HOST=103.150.194.228
RESULT_DB_PORT=3306
RESULT_DB_NAME=aqms_db
RESULT_DB_USER=admin
RESULT_DB_PASSWORD=

# Optional: protect mutation endpoints (predict/retrain)
# Harus sama dengan FORECAST_API_KEY di .env Laravel
# Kosongkan untuk menonaktifkan autentikasi
INTERNAL_API_KEY=

# Opsional — model prakiraan (nilai bawaan sudah sesuai untuk Berau)
# LOCAL_UTC_OFFSET_HOURS=8   # zona waktu lokasi (WITA)
# BACKTEST_FOLDS=6           # jumlah lipatan 4-mingguan pada evaluasi saat retrain
# LGBM_N_JOBS=4              # thread LightGBM saat melatih
# PREDICT_SCHEDULE_MINUTE=55 # prediksi semua sensor tiap jam pada menit ini
# INTERNAL_SCHEDULER=1       # 0 = matikan penjadwal internal (bila dipicu dari luar)
